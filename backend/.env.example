# PostgreSQL — docker compose veritabanını bu değerlerle oluşturur
DB_USER=istakip
DB_PASSWORD=istakip
DB_NAME=istakip
DB_PORT=5433
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?sslmode=disable

JWT_SECRET=değiştir-bu-gizli-anahtarı
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PORT=8080
# Talep formu dosya yüklemeleri (göreli yol backend/ klasörüne göredir)
UPLOAD_DIR=uploads
# Web uygulamasının açıldığı adresler (virgülle ayrılmış).
# Sunucuda: http://<SUNUCU_IP>
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
